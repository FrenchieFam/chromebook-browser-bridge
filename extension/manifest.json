{
  "manifest_version": 3,
  "name": "Chromebook Browser Bridge",
  "version": "0.4.0",
  "minimum_chrome_version": "118",
  "description": "Local control of a chosen tab or an optional persistent pinned work tab. Disconnect or cancel the banner to pause.",
  "permissions": [
    "debugger",
    "activeTab",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chromebook Browser Bridge"
  },
  "optional_permissions": [
    "power"
  ]
}
